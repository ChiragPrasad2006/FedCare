# Main Server Configuration
MAIN_SERVER_HOST=localhost
MAIN_SERVER_PORT=5000

# Federated Learning Configuration
NUM_ROUNDS=10
NUM_HOSPITALS=3
EPOCHS_PER_ROUND=5
BATCH_SIZE=32
TEST_SIZE=0.2

# Model Configuration
LEARNING_RATE=0.001

# Security and Privacy (Optional - for future enhancement)
ENCRYPTION_ENABLED=False
SECURE_AGGREGATION=False
DIFFERENTIAL_PRIVACY=False

# AWS Configuration (Optional)
AWS_REGION=us-east-1
SAGEMAKER_ROLE_ARN=
BUCKET_NAME=fedcare-models

# Logging
LOG_LEVEL=INFO
LOG_DIR=./logs

# Database (Optional - for future enhancement)
MONGODB_URI=mongodb://localhost:27017
DB_NAME=fedcare

# API Configuration
API_TIMEOUT=300
MAX_RETRIES=3
RETRY_BACKOFF=1.0
